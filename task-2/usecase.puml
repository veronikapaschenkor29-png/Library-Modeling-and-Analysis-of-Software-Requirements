@startuml use-case
left to right direction
skinparam packageStyle rectangle

actor "Читач" as Reader
actor "Бібліотекар" as Librarian

rectangle "Бібліотека" {
  usecase "Позичити книгу" as Borrow
  usecase "Перевірити борги читача" as CheckDebts
  usecase "Повернути книгу" as Return
  usecase "Створити штраф" as CreateFine
  usecase "Забронювати книгу" as Reserve
}

Reader --> Borrow
Reader --> Return
Reader --> Reserve
Librarian --> Return

Borrow ..> CheckDebts : <<include>>
Reserve ..> Borrow : <<extend>>
CreateFine ..> Return : <<extend>>
@enduml