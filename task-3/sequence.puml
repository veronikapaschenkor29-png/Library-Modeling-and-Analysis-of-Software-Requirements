@startuml d4-limit-exceeded
autonumber

actor "Читач" as Reader
participant "Web UI" as WebUI
participant "Loan Service" as LoanService
participant "Member Service" as MemberService
participant "Catalog Service" as CatalogService
participant "Reservation Service" as ReservationService
participant "Notification Service" as NotificationService
participant "Data Access" as DataAccess
database "БД" as DB

Reader -> WebUI : запит видачі
activate WebUI
WebUI -> LoanService : borrowBook(memberId, bookId)
activate LoanService
LoanService -> MemberService : countActiveLoans(memberId)
activate MemberService
MemberService -> DB : countLoans(memberId)
activate DB
DB --> MemberService : 5
deactivate DB
MemberService --> LoanService : count = 5
deactivate MemberService
alt Перевищено ліміт (>= 5)
  LoanService --> WebUI : відмова (ліміт)
  WebUI --> Reader : перевищено ліміт 5 книг
end
deactivate LoanService
deactivate WebUI
@enduml

@startuml d5-return-overdue-fine
autonumber

actor "Читач" as Reader
participant "Web UI" as WebUI
participant "Loan Service" as LoanService
participant "Member Service" as MemberService
participant "Catalog Service" as CatalogService
participant "Reservation Service" as ReservationService
participant "Notification Service" as NotificationService
participant "Data Access" as DataAccess
database "БД" as DB

Reader -> WebUI : повернення книги
activate WebUI
WebUI -> LoanService : returnBook(loanId)
activate LoanService
LoanService -> DB : findLoan(loanId)
activate DB
DB --> LoanService : loan
deactivate DB
alt Прострочено
  LoanService -> DB : updateLoan(loanId, returned_at, status="повернено")
  activate DB
  DB --> LoanService : ok
  deactivate DB
  LoanService -> DB : createFine(loanId, amount, paid=false)
  activate DB
  DB --> LoanService : fine
  deactivate DB
  LoanService -> DB : updateCopyStatus(loan.copyId, "доступний")
  activate DB
  DB --> LoanService : ok
  deactivate DB
  LoanService --> WebUI : штраф створено
  WebUI --> Reader : повідомлення про штраф
else Вчасно
  LoanService -> DB : updateLoan(loanId, returned_at, status="повернено")
  activate DB
  DB --> LoanService : ok
  deactivate DB
  LoanService -> DB : updateCopyStatus(loan.copyId, "доступний")
  activate DB
  DB --> LoanService : ok
  deactivate DB
  LoanService --> WebUI : повернення прийнято
  WebUI --> Reader : без штрафу
end
deactivate LoanService
deactivate WebUI
@enduml